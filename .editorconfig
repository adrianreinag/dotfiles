# EditorConfig: https://editorconfig.org
# Helps maintain consistent coding styles across editors and IDEs

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript/TypeScript/JSON
[*.{js,jsx,ts,tsx,json}]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 4

# Python
[*.py]
indent_size = 4

# Dart/Flutter
[*.dart]
indent_size = 2

# HTML/CSS
[*.{html,css,scss,sass}]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# Git config files
[.git*]
indent_size = 4
